PORT=4000
# Por padrao, no Windows, o banco fica em %LOCALAPPDATA%/IDSensorMVP/id_sensor_mvp.db.
# Use DATABASE_PATH apenas se quiser sobrescrever.
# DATABASE_PATH=C:\Users\SEU_USUARIO\AppData\Local\IDSensorMVP\id_sensor_mvp.db
# No Render, use a Internal Database URL do PostgreSQL.
# DATABASE_URL=postgresql://...
PUBLIC_API_URL=http://localhost:4000
APP_DEEP_LINK_BASE=idsensor://
EXPO_PUSH_ENABLED=true
AUTO_SEED_DEMO_DATA=true

# MQTT bridge HiveMQ -> leituras de carrinho
MQTT_BRIDGE_ENABLED=false
MQTT_HOST=c0d66ad786a241bf91a20a7509b2ac7c.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=mkgw4
MQTT_PASSWORD=
