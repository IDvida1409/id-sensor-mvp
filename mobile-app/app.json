{
  "expo": {
    "name": "IDsensor",
    "slug": "idsensor-mobile",
    "scheme": "idsensor",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f8fc"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.idvida.idsensor"
    },
    "android": {
      "package": "br.com.idvida.idsensor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o IDsensor acesse a camera para escanear equipamentos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "apiBaseUrl": "https://id-sensor-mvp.onrender.com"
    }
  }
}
